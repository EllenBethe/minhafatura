rules_version = '2';

// Espelho das regras publicadas no console do Firebase (Firestore → Regras).
// Ao alterar aqui, publique também com `npx firebase-tools deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário acessa SOMENTE os próprios dados
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /compras/{compraId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // valorParcela negativo = estorno/crédito (abate a fatura); zero não faz sentido
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.desc is string
          && request.resource.data.desc.size() <= 200
          && request.resource.data.parcelas is int
          && request.resource.data.parcelas >= 1
          && request.resource.data.parcelas <= 72
          && request.resource.data.valorParcela is number
          && request.resource.data.valorParcela != 0;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
